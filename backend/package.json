{
  "name": "resumematch-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Resume and job description matching API and Telegram bot",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/**/*.js tests/unit/**/*.js",
    "test:unit": "node --test tests/unit/**/*.js",
    "test:smoke": "node --test test/**/*.js",
    "eval": "node tests/evaluation_dataset/run_evaluation.js",
    "build": "node --check src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "mammoth": "^1.9.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}