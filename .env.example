# Root .env.example — Copy to .env and fill in every variable

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
PORT=8000

# ─── Database ─────────────────────────────────────────────────
# MongoDB Atlas or local instance (optional — system works without it)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resumematch

# Postgres credentials used by Docker Compose
POSTGRES_USER=resumematch
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=resumematch

# ─── Redis ────────────────────────────────────────────────────
# Leave empty to disable Redis; Docker Compose sets this automatically
REDIS_URL=redis://localhost:6379

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── AI / LLM ─────────────────────────────────────────────────
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── File Limits ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── Scoring Thresholds ───────────────────────────────────────
SUITABLE_THRESHOLD=75
BORDERLINE_THRESHOLD=60

# ─── Rate Limiting ────────────────────────────────────────────
ANALYSIS_RATE_LIMIT_SECONDS=10

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
